# cp .env.example .env
#
# Everything runs with NONE of this filled in — the replay rail needs no credentials at
# all. Fill in a section only when you want that part to be real.
#
# ─────────────────────────────────────────────────────────────────────────────────────
#  WHAT YOU ACTUALLY NEED TO PASTE
# ─────────────────────────────────────────────────────────────────────────────────────
#
#   1. Razorpay test keys      — for real payments on both lanes.  ~2 min
#   2. SMTP                    — for order receipts and password resets.  ~5 min
#   3. Secrets                 — change these before anything is public.  ~1 min
#
#   Cloudinary is optional. Without it, profile pictures become a coloured initial and
#   registration still works.
#
# ═════════════════════════════════════════════════════════════════════════════════════
#  1 · RAZORPAY
# ═════════════════════════════════════════════════════════════════════════════════════
# Dashboard → Account & Settings → API Keys → Generate Test Key.
# You get a key id (rzp_test_…) and a secret, shown once.

# The AGENT lane. This reaches ONLY the executor service, which has no public ingress.
# `make creds` proves it is absent from kernel, worker, web and buyer-agent — and keeps
# proving it after you put a real key here.
RZP_KEY_ID=
RZP_KEY_SECRET=

# The HUMAN lane — the storefront's own checkout. Same account, different lane.
# Usually the same pair. Leave blank and checkout returns a clean 503 instead of crashing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Switch the agent lane to real Razorpay. Leave as `replay` until the keys above work.
RAIL=replay

# Dashboard → Settings → Webhooks → Add. Point it at:
#     <your public url>/agent/webhooks/razorpay
# Subscribe to payment.captured and payment.failed, then paste the signing secret here.
# For a public url:  ngrok http 58080
WEBHOOK_SECRET=whsec_replay_dev_only

# ═════════════════════════════════════════════════════════════════════════════════════
#  2 · EMAIL  (order receipts, password reset)
# ═════════════════════════════════════════════════════════════════════════════════════
# Any SMTP mailbox. Gmail needs an App Password, not your normal one:
#     Google Account → Security → 2-Step Verification → App passwords
# Or use Mailtrap for a throwaway inbox that catches everything.
#
# Leave blank and emails are logged instead of sent — nothing breaks.
SMTP_HOST=
SMTP_PORT=587
SMTP_MAIL=
SMTP_PASSWORD=
SMTP_FROM=

# ═════════════════════════════════════════════════════════════════════════════════════
#  3 · SECRETS  — change all of these before anything is reachable from outside
# ═════════════════════════════════════════════════════════════════════════════════════
# Generate with:  openssl rand -hex 32
EXECUTOR_TOKEN=executor-dev-token
AGENTKIT_FULFIL_TOKEN=fulfil-dev-token
JWT_SECRET=storefront-dev-secret
PG_KERNEL_PASSWORD=agentkit
PG_WORKER_PASSWORD=agentkit
PG_CONSOLE_PASSWORD=agentkit
PG_ADMIN_PASSWORD=agentkit
PG_OWNER_PASSWORD=agentkit

# ═════════════════════════════════════════════════════════════════════════════════════
#  4 · OPTIONAL
# ═════════════════════════════════════════════════════════════════════════════════════
# Profile pictures. Without these, avatars are a coloured initial.
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ═════════════════════════════════════════════════════════════════════════════════════
#  5 · PUBLIC URLS  — only when exposing this beyond localhost
# ═════════════════════════════════════════════════════════════════════════════════════
#     ngrok http 58080     then paste the https url into both of these
# Get this wrong and the agent manifest advertises localhost, which no remote agent
# can reach.
PUBLIC_BASE_URL=http://localhost:58080
PUBLIC_KERNEL_URL=http://localhost:58080

# Only true behind a proxy that OVERWRITES X-Forwarded-For. Set it when tunnelling, or
# every anonymous caller shares one rate-limit bucket and one flooder locks out everyone.
TRUST_PROXY=false

# ═════════════════════════════════════════════════════════════════════════════════════
#  6 · MODES  — leave these alone unless you know why
# ═════════════════════════════════════════════════════════════════════════════════════
BRAIN=scripted
VERIFIER=scripted
MERCHANT_ID=mch_sharma_kirana
MERCHANT_NAME=Sharma Kirana
# Which tool classes MCP exposes. Drop `money` to let agents browse but never pay.
MCP_EXPOSE=read,propose,money
