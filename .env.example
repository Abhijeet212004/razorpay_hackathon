# cp .env.example .env
#
# Everything below is optional. With no .env at all the whole system runs on the replay
# rail: a real HTTP server serving recorded Razorpay responses and firing real signed
# webhooks. Nothing is faked except the far side of the socket.

# ── Which rail ────────────────────────────────────────────────────────────────────────
# replay   recorded, no credentials, the default
# razorpay real Razorpay Test Mode
RAIL=replay

# BRAIN     scripted | claude       the buyer agent's planner
# VERIFIER  scripted | claude | off the blind verifier (off is replay-only)
BRAIN=scripted
VERIFIER=scripted

# ── The agent lane ────────────────────────────────────────────────────────────────────
# Reaches ONLY the executor service, which has no public ingress. `make creds` proves it
# is absent from kernel, worker, web and buyer-agent — and keeps proving it after you put
# a real key here.
RZP_KEY_ID=
RZP_KEY_SECRET=

# From the Razorpay dashboard, once you register the webhook at
#   <your-tunnel>/agent/webhooks/razorpay
WEBHOOK_SECRET=whsec_replay_dev_only

# ── The human lane ────────────────────────────────────────────────────────────────────
# The storefront's own checkout. Same account, different lane. Leave blank and the
# checkout returns a clean 503 instead of crashing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Identity ──────────────────────────────────────────────────────────────────────────
MERCHANT_ID=mch_sharma_kirana
MERCHANT_NAME=Sharma Kirana
PUBLIC_BASE_URL=http://localhost:58080
PUBLIC_KERNEL_URL=http://localhost:58080

# ── Secrets you should change before anything leaves your machine ─────────────────────
EXECUTOR_TOKEN=executor-dev-token
JWT_SECRET=storefront-dev-secret
PG_KERNEL_PASSWORD=agentkit
PG_WORKER_PASSWORD=agentkit
PG_CONSOLE_PASSWORD=agentkit
PG_ADMIN_PASSWORD=agentkit
PG_OWNER_PASSWORD=agentkit
